{
  "version": 2,
  "builds": [
    {
      "src": "sync-server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/sync-server.js"
    }
  ],
  "env": {
    "REACT_APP_BIGQUERY_PROJECT_ID": "impacts-tracker",
    "REACT_APP_BIGQUERY_CREDENTIALS": "@bigquery_credentials"
  }
}





