# Supabase Configuration
# Copy this file to .env and fill in your values

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (SECRET - never commit this!)
# Get from: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Client (CRA / Vercel): PECC hospital continuity — after backfill to hospital_data, enable to stop
# dual-writing and legacy user_data reads for continuity keys (build-time; redeploy required).
# REACT_APP_DISABLE_LEGACY_USER_MIRROR=true

# Optional MFA first-login how-to video (YouTube, Vimeo, mp4 URL, or site path)
# REACT_APP_MFA_SETUP_VIDEO_URL=/media/mfa-first-login-setup.mp4
