const AssessmentPage: React.FC = () => {
  const { currentUser } = useAuth();
  const [scores, setScores] = useState<ReadinessScore[]>([]);
  const [assessment, setAssessment] = useState<AssessmentQuestion[]>(ASSESSMENT_QUESTIONS);
  const [gapPlans, setGapPlans] = useState<GapPlan[]>([]);
  const [openScoreDialog, setOpenScoreDialog] = useState(false);
  const [openGapDialog, setOpenGapDialog] = useState(false);
  const [selectedQuestion, setSelectedQuestion] = useState<AssessmentQuestion | null>(null);
  const [scoreFormData, setScoreFormData] = useState({
    date: '',
    score: '',
    pdfFile: null as File | null
  });
  const [gapFormData, setGapFormData] = useState({
    action: '',
    owner: '',
    status: '' as GapPlan['status'],
    priority: '' as GapPlan['priority'],
    difficulty: '' as GapPlan['difficulty'],
    notes: '',
    dueDate: '',
    completionDate: '',
    rank: '' as GapPlan['rank'],
    attachments: [] as GapPlanAttachment[]
  });
  const [error, setError] = useState<string | null>(null);

  const dataLoadedRef = useRef(false);

  useEffect(() => {
    if (currentUser?.uid && !dataLoadedRef.current) {
      dataLoadedRef.current = true;
      loadData();
    }
  }, [currentUser?.uid]);

  // Refresh gap plans when component becomes visible again
  useEffect(() => {
    const handleVisibilityChange = () => {
      if (!document.hidden && currentUser?.uid) {
        console.log('Page became visible, refreshing gap plans');
        refreshGapPlans();
      }
    };

    document.addEventListener('visibilitychange', handleVisibilityChange);
    return () => document.removeEventListener('visibilitychange', handleVisibilityChange);
  }, [currentUser?.uid]);

  // Auto-save scores when they change
  useEffect(() => {
    if (currentUser?.uid && scores.length > 0) {
      console.log('Scores changed, auto-saving...');
      localStorage.setItem(`readinessScores_${currentUser.uid}`, JSON.stringify(scores));
    }
  }, [scores, currentUser?.uid]);

  const loadData = () => {
    try {
      console.log('Loading data for user:', currentUser?.uid);
      const savedScores = localStorage.getItem(`readinessScores_${currentUser?.uid}`);
      const savedAssessment = localStorage.getItem(`readinessAssessment_${currentUser?.uid}`);
      const savedGapPlans = localStorage.getItem(`gapPlans_${currentUser?.uid}`);

      console.log('Found saved gap plans:', savedGapPlans);
      if (savedScores) setScores(JSON.parse(savedScores));
      if (savedAssessment) setAssessment(JSON.parse(savedAssessment));
      if (savedGapPlans) {
        const parsedGapPlans = JSON.parse(savedGapPlans);
        console.log('Parsed gap plans:', parsedGapPlans);
        setGapPlans(parsedGapPlans);
      }
      console.log('Data loaded successfully');
    } catch (err) {
      console.error('Error loading data:', err);
      setError('Failed to load assessment data');
    }
  };

  const refreshGapPlans = () => {
    try {
      const savedGapPlans = localStorage.getItem(`gapPlans_${currentUser?.uid}`);
      if (savedGapPlans) {
        const parsedGapPlans = JSON.parse(savedGapPlans);
        console.log('Refreshing gap plans from localStorage:', parsedGapPlans);
        setGapPlans(parsedGapPlans);
      }
    } catch (err) {
      console.error('Error refreshing gap plans:', err);
    }
  };

  const saveData = () => {
    try {
      console.log('Saving data for user:', currentUser?.uid);
      console.log('Saving gap plans:', gapPlans);
      localStorage.setItem(`readinessScores_${currentUser?.uid}`, JSON.stringify(scores));
      localStorage.setItem(`readinessAssessment_${currentUser?.uid}`, JSON.stringify(assessment));
      localStorage.setItem(`gapPlans_${currentUser?.uid}`, JSON.stringify(gapPlans));
      console.log('Data saved successfully');
    } catch (err) {
      console.error('Error saving data:', err);
      setError('Failed to save assessment data');
    }
  };

  const handleScoreSubmit = () => {
    if (!scoreFormData.date || !scoreFormData.score) {
      setError('Please fill in all required fields');
      return;
    }

    const score = parseFloat(scoreFormData.score);
    if (isNaN(score) || score < 0 || score > 100) {
      setError('Score must be between 0 and 100');
      return;
    }

    const newScore: ReadinessScore = {
      id: Date.now().toString(),
      date: scoreFormData.date,
      score: score,
      pdfFile: scoreFormData.pdfFile ? URL.createObjectURL(scoreFormData.pdfFile) : undefined
    };

    setScores([...scores, newScore]);
    setScoreFormData({ date: '', score: '', pdfFile: null });
    setOpenScoreDialog(false);
    setError(null);
    saveData(); // Save the new score to localStorage
  };

  const handleAssessmentChange = (questionId: string, answer: string | string[] | null) => {
    console.log('handleAssessmentChange called:', { questionId, answer, currentAnswer: assessment.find(q => q.id === questionId)?.answer });
    const updatedAssessment = assessment.map(q => 
      q.id === questionId ? { ...q, answer } : q
    );
    console.log('Updated assessment for question:', updatedAssessment.find(q => q.id === questionId));
    setAssessment(updatedAssessment);
    saveData();
  };



  const handleGapPlanOpen = (question: AssessmentQuestion) => {
    setSelectedQuestion(question);
    const existingPlan = gapPlans.find(plan => plan.questionId === question.id);
    if (existingPlan) {
      setGapFormData({
        action: existingPlan.action,
        owner: existingPlan.owner,
        status: existingPlan.status,
        priority: existingPlan.priority,
        difficulty: existingPlan.difficulty,
        notes: existingPlan.notes,
        dueDate: existingPlan.dueDate,
        completionDate: existingPlan.completionDate,
        rank: existingPlan.rank,
        attachments: existingPlan.attachments || []
      });
    } else {
      setGapFormData({
        action: '',
        owner: '',
        status: '',
        priority: '',
        difficulty: '',
        notes: '',
        dueDate: '',
        completionDate: '',
        rank: '',
        attachments: []
      });
    }
    setOpenGapDialog(true);
  };

  const handleGapPlanCreate = (questionId: string) => {
    setSelectedQuestion({ id: questionId, text: assessment.find(q => q.id === questionId)?.text || 'Unknown Question' } as AssessmentQuestion);
    setGapFormData({
      action: '',
      owner: '',
      status: '',
      priority: '',
      difficulty: '',
      notes: '',
      dueDate: '',
      completionDate: '',
      rank: '',
      attachments: []
    });
    setOpenGapDialog(true);
  };

  const handleGapPlanSubmit = () => {
    if (!gapFormData.action || !gapFormData.owner) {
      setError('Please fill in all required fields');
      return;
    }

    console.log('Submitting gap plan for question:', selectedQuestion?.id);
    console.log('Current gap plans before update:', gapPlans);

    // Get the next available rank
    const nextRank = gapPlans.length > 0 ? Math.max(...gapPlans.map(p => typeof p.rank === 'number' ? p.rank : 0)) + 1 : 1;
    
    const newPlan: GapPlan = {
      id: Date.now().toString(),
      questionId: selectedQuestion!.id,
      questionText: selectedQuestion!.text,
      ...gapFormData,
      rank: nextRank,
      attachments: []
    };

    console.log('New gap plan:', newPlan);

    // Check if this is a completed plan for a Yes/No question
    if (newPlan.status === 'Completed' && selectedQuestion?.type === 'yesno') {
      const shouldUpdate = window.confirm(
        `This gap plan is for a Yes/No question: "${selectedQuestion.text}"\n\n` +
        `Would you like the system to automatically update the assessment answer to "Yes" since this gap has been completed?`
      );
      
      if (shouldUpdate) {
        // Update the assessment answer
        const updatedAssessment = assessment.map(q => 
          q.id === selectedQuestion.id ? { ...q, answer: 'yes' } : q
        );
        setAssessment(updatedAssessment);
        
        // Save assessment update
        try {
          localStorage.setItem(`readinessAssessment_${currentUser?.uid}`, JSON.stringify(updatedAssessment));
          console.log('Assessment updated automatically for completed gap plan');
        } catch (err) {
          console.error('Error saving assessment update:', err);
        }
      }
    }

    const updatedPlans = gapPlans.filter(plan => plan.questionId !== selectedQuestion!.id);
    const finalPlans = [...updatedPlans, newPlan];
    console.log('Updated gap plans:', finalPlans);

    // Save to localStorage immediately with the new plans
    try {
      localStorage.setItem(`gapPlans_${currentUser?.uid}`, JSON.stringify(finalPlans));
      console.log('Gap plans saved to localStorage immediately');
    } catch (err) {
      console.error('Error saving gap plans immediately:', err);
    }

    setGapPlans(finalPlans);
    setOpenGapDialog(false);
    setError(null);
  };

  const handleSubQuestionChange = (questionId: string, subQuestionId: string, answer: string) => {
    const updatedAssessment = assessment.map(q => 
      q.id === questionId ? {
        ...q,
        subQuestions: q.subQuestions?.map(sq => 
          sq.id === subQuestionId ? { ...sq, answer } : sq
        )
      } : q
    );
    setAssessment(updatedAssessment);
    saveData();
  };

  const handleGapPlanDelete = () => {
    if (!selectedQuestion) return;
    
    // Find the existing gap plan for this question
    const existingGapPlan = gapPlans.find(plan => plan.questionId === selectedQuestion.id);
    
    if (existingGapPlan) {
      // Remove the gap plan
      const updatedGapPlans = gapPlans.filter(plan => plan.id !== existingGapPlan.id);
      setGapPlans(updatedGapPlans);
      
      // Save to localStorage immediately
      try {
        localStorage.setItem(`gapPlans_${currentUser?.uid}`, JSON.stringify(updatedGapPlans));
        console.log('Gap plan deleted and saved to localStorage');
      } catch (err) {
        console.error('Error saving gap plans after deletion:', err);
      }
    }
    
    setOpenGapDialog(false);
    setGapFormData({
      action: '',
      owner: '',
      status: '',
      priority: '',
      difficulty: '',
      notes: '',
      dueDate: '',
      completionDate: '',
      rank: '',
      attachments: []
    });
  };



  const handleGapPlanEdit = (plan: GapPlan) => {
    setSelectedQuestion({ id: plan.questionId, text: plan.questionText } as AssessmentQuestion);
    setGapFormData({
      action: plan.action,
      owner: plan.owner,
      status: plan.status,
      priority: plan.priority,
      difficulty: plan.difficulty,
      notes: plan.notes,
      dueDate: plan.dueDate,
      completionDate: plan.completionDate,
      rank: plan.rank,
      attachments: plan.attachments || []
    });
    setOpenGapDialog(true);
  };

  const handleGapPlanFileUpload = (event: React.ChangeEvent<HTMLInputElement>) => {
    const files = event.target.files;
    if (!files) return;

    Array.from(files).forEach(file => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const fileData = e.target?.result as string;
        const attachment: GapPlanAttachment = {
          id: Date.now().toString() + Math.random(),
          fileName: file.name,
          fileType: file.type.includes('pdf') ? 'pdf' : 'image',
          fileSize: file.size,
          uploadedAt: new Date(),
          fileData: fileData
        };
        
        setGapFormData(prev => ({
          ...prev,
          attachments: [...prev.attachments, attachment]
        }));
      };
      reader.readAsDataURL(file);
    });
  };

  const handleRemoveAttachment = (index: number) => {
    setGapFormData(prev => ({
      ...prev,
      attachments: prev.attachments.filter((_, i) => i !== index)
    }));
  };



  const formatDate = (dateString: string) => {
    try {
      // Fix timezone issue by creating date in local timezone
      const [year, month, day] = dateString.split('-').map(Number);
      const date = new Date(year, month - 1, day); // month is 0-indexed
      return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      });
    } catch (err) {
      return dateString;
    }
  };

  const exportToPDF = () => {
    const doc = new jsPDF();
    let yPos = 20;
    
    doc.setFontSize(18);
    doc.text('Pediatric Readiness Assessment Report', 20, yPos);
    yPos += 20;
    
    doc.setFontSize(12);
    doc.text(`Generated on: ${new Date().toLocaleDateString()}`, 20, yPos);
    yPos += 15;
    
    // Scores section
    if (scores.length > 0) {
      doc.text('Readiness Scores:', 20, yPos);
      yPos += 10;
      scores.forEach(score => {
        doc.text(`${formatDate(score.date)}: ${score.score}`, 30, yPos);
        yPos += 8;
      });
      yPos += 10;
    }
    
    // Assessment section
    doc.text('Assessment Responses:', 20, yPos);
    yPos += 10;
    
    assessment.forEach(question => {
      if (yPos > 250) {
        doc.addPage();
        yPos = 20;
      }
      
      doc.setFontSize(10);
      doc.text(`Q${question.id}: ${question.text}`, 20, yPos);
      yPos += 5;
      
      if (question.answer) {
        doc.text(`Answer: ${Array.isArray(question.answer) ? question.answer.join(', ') : question.answer}`, 30, yPos);
        yPos += 5;
      }
      
      yPos += 5;
    });
    
    doc.save('readiness-assessment-report.pdf');
  };

  const exportToExcel = () => {
    const exportData = assessment.map(q => ({
      Question: q.text,
      Answer: Array.isArray(q.answer) ? q.answer.join(', ') : q.answer || '',
      GapPlan: gapPlans.find(plan => plan.questionId === q.id) ? 'Yes' : 'No'
    }));
    
    const ws = XLSX.utils.json_to_sheet(exportData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Assessment');
    
    XLSX.writeFile(wb, 'readiness-assessment.xlsx');
  };

  return (
    <Container maxWidth="xl">
      <Box sx={{ mb: 4 }}>
        <Typography variant="h4" component="h1" gutterBottom>
          Pediatric Readiness Assessment
        </Typography>
        <Typography variant="body1" color="text.secondary" sx={{ mb: 3 }}>
          Complete your pediatric readiness assessment and track your progress over time.
        </Typography>

        {error && (
          <Alert severity="error" sx={{ mb: 2 }} onClose={() => setError(null)}>
            {error}
          </Alert>
        )}

        {/* Export Buttons */}
        <Box sx={{ mb: 3, display: 'flex', gap: 2 }}>
          <Button
            variant="outlined"
            startIcon={<TableChartIcon />}
            onClick={exportToExcel}
            sx={{ borderColor: 'success.main', color: 'success.main', '&:hover': { borderColor: 'success.dark', bgcolor: 'success.light' } }}
          >
            Export to Excel
          </Button>
          <Button
            variant="contained"
            startIcon={<PictureAsPdfIcon />}
            onClick={exportToPDF}
            sx={{ bgcolor: 'error.main', '&:hover': { bgcolor: 'error.dark' } }}
          >
            Export to PDF
        </Button>
        </Box>

        {/* Readiness Scores Section */}
        <Card sx={{ mb: 3 }}>
          <CardContent sx={{ p: 2 }}>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1.5 }}>
              <Typography variant="h6">Official Readiness Scores</Typography>
              <Button
                variant="contained"
                startIcon={<AddIcon />}
                onClick={() => setOpenScoreDialog(true)}
                size="small"
              >
                Add New Score
              </Button>
            </Box>
            
            {scores.length === 0 ? (
              <Typography color="text.secondary" sx={{ py: 2 }}>No scores recorded yet.</Typography>
            ) : (
              <TableContainer>
                <Table size="small">
                  <TableHead>
                    <TableRow>
                      <TableCell sx={{ py: 1, px: 1 }}>Date</TableCell>
                      <TableCell sx={{ py: 1, px: 1 }}>Score</TableCell>
                      <TableCell sx={{ py: 1, px: 1 }}>PDF</TableCell>
                      <TableCell sx={{ py: 1, px: 1 }}>Actions</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {scores
                      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()) // Sort by date, newest first
                      .map((score) => (
                      <TableRow key={score.id}>
                        <TableCell sx={{ py: 1, px: 1 }}>{formatDate(score.date)}</TableCell>
                        <TableCell sx={{ py: 1, px: 1 }}>{score.score}</TableCell>
                        <TableCell sx={{ py: 1, px: 1 }}>
                          {score.pdfFile && (
                            <Button
                              size="small"
                              onClick={() => window.open(score.pdfFile, '_blank')}
                              sx={{ minWidth: 'auto', px: 1 }}
                            >
                              View PDF
                            </Button>
                          )}
                        </TableCell>
                        <TableCell sx={{ py: 1, px: 1 }}>
                          <IconButton
                            size="small"
                            onClick={() => {
                              setScores(scores.filter(s => s.id !== score.id));
                              saveData();
                            }}
                          >
                            <DeleteIcon fontSize="small" />
                          </IconButton>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            )}
          </CardContent>
        </Card>

        {/* Assessment Questions */}
        <Card>
          <CardContent>
            <Typography variant="h6" sx={{ mb: 3 }}>Assessment Questions</Typography>
            
            {assessment.map((question) => (
              <Box key={question.id} sx={{ mb: 1, p: 1, border: '1px solid', borderColor: 'grey.300', borderRadius: 1 }}>
                {/* Question Number and Text */}
                <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 0.5 }}>
                  <Typography variant="body1" sx={{ fontWeight: 'bold', flexGrow: 1, fontSize: '1rem' }}>
                    Question {question.id}: {question.text}
                  </Typography>
                  {/* Only show Gap Plan button for questions 22-78 */}
                  {(() => {
                    const numId = parseInt(question.id);
                    const isSubQuestion = question.id.includes('a') || question.id.includes('b') || question.id.includes('c') || question.id.includes('d') || question.id.includes('e') || question.id.includes('f') || question.id.includes('g') || question.id.includes('h') || question.id.includes('i') || question.id.includes('j') || question.id.includes('k') || question.id.includes('l') || question.id.includes('m');
                    
                    if (isSubQuestion) {
                      // For sub-questions like 18a, 18b, 44a, etc., check if the base number is 18 or higher
                      const baseNum = parseInt(question.id.replace(/[a-z]/g, ''));
                      if (baseNum >= 18) {
                        return (
                          <Button
                            variant="outlined"
                            startIcon={<EditIcon />}
                            onClick={() => handleGapPlanCreate(question.id)}
                            size="small"
                            sx={{ ml: 2, flexShrink: 0 }}
                          >
                            Gap Plan
                          </Button>
                        );
                      }
                    } else if (!isNaN(numId) && numId >= 22 && numId <= 78) {
                      // For regular questions 22-78
                      return (
                        <Button
                          variant="outlined"
                          startIcon={<EditIcon />}
                          onClick={() => handleGapPlanCreate(question.id)}
                          size="small"
                          sx={{ ml: 2, flexShrink: 0 }}
                        >
                          Gap Plan
                        </Button>
                      );
                    }
                    return null; // No gap plan button for other questions
                  })()}
                </Box>

                {/* Note if present */}
                {question.note && (
                  <Typography variant="body2" color="text.secondary" sx={{ fontStyle: 'italic', mb: 0.5, fontSize: '0.875rem' }}>
                    {question.note}
                  </Typography>
                )}

                {/* Answer Input */}
                {question.type === 'yesno' && (
                  <Box sx={{ display: 'flex', flexDirection: 'row', gap: 2 }}>
                    <FormControlLabel
                      control={
                        <Checkbox
                          checked={question.answer === 'yes'}
                          onChange={() => {
                            console.log('Yes checkbox clicked. Current answer:', question.answer);
                            if (question.answer === 'yes') {
                              console.log('Unchecking Yes, setting to null');
                              handleAssessmentChange(question.id, null);
                            } else {
                              console.log('Checking Yes');
                              handleAssessmentChange(question.id, 'yes');
                            }
                          }}
                        />
                      }
                      label="Yes"
                    />
                    <FormControlLabel
                      control={
                        <Checkbox
                          checked={question.answer === 'no'}
                          onChange={() => {
                            console.log('No checkbox clicked. Current answer:', question.answer);
                            if (question.answer === 'no') {
                              console.log('Unchecking No, setting to null');
                              handleAssessmentChange(question.id, null);
                            } else {
                              console.log('Checking No');
                              handleAssessmentChange(question.id, 'no');
                            }
                          }}
                        />
                      }
                      label="No"
                    />
                  </Box>
                )}

                {question.type === 'text' && (
                  <TextField
                    fullWidth
                    value={question.answer || ''}
                    onChange={(e) => handleAssessmentChange(question.id, e.target.value)}
                    placeholder="Enter your answer..."
                    sx={{ mt: 1 }}
                  />
                )}

                {question.type === 'dropdown' && question.options && (
                  <FormControl fullWidth sx={{ mt: 1 }}>
                    <InputLabel>Select an option</InputLabel>
                    <Select
                      value={question.answer || ''}
                      onChange={(e) => handleAssessmentChange(question.id, e.target.value)}
                      label="Select an option"
                    >
                      {question.options.map((option) => (
                        <MenuItem key={option} value={option}>
                          {option}
                        </MenuItem>
                      ))}
                    </Select>
                  </FormControl>
                )}

                {question.type === 'numeric' && (
                  <TextField
                    fullWidth
                    type="number"
                    value={question.answer || ''}
                    onChange={(e) => handleAssessmentChange(question.id, e.target.value)}
                    placeholder="Enter numeric answer..."
                    sx={{ mt: 1 }}
                  />
                )}

                {question.type === 'radio' && question.options && (
                  <Box sx={{ display: 'flex', flexDirection: 'row', gap: 2, flexWrap: 'wrap' }}>
                    {question.options.map((option) => (
                      <FormControlLabel
                        key={option}
                        control={
                          <Radio
                            checked={question.answer === option}
                            onChange={() => {
                              if (question.answer === option) {
                                // If already selected, unclick it
                                handleAssessmentChange(question.id, null);
                              } else {
                                // Select this option
                                handleAssessmentChange(question.id, option);
                              }
                            }}
                          />
                        }
                        label={option}
                      />
                    ))}
                  </Box>
                )}

                {question.type === 'checkbox' && question.options && (
                  <FormGroup>
                    {question.options.map((option) => (
                      <FormControlLabel
                        key={option}
                        control={
                          <Checkbox
                            checked={question.answer?.includes(option)}
                            onChange={(e) => {
                              const currentAnswer = Array.isArray(question.answer) ? question.answer : [];
                              if (e.target.checked) {
                                setAssessment(assessment.map(q => 
                                  q.id === question.id ? { ...q, answer: [...currentAnswer, option] } : q
                                ));
                              } else {
                                setAssessment(assessment.map(q => 
                                  q.id === question.id ? { ...q, answer: currentAnswer.filter((a: string) => a !== option) } : q
                                ));
                              }
                            }}
                          />
                        }
                        label={option}
                      />
                    ))}
                  </FormGroup>
                )}

                {/* Sub-questions rendering for questions that still have them */}
                {question.type === 'subquestions' && question.subQuestions && (
                  <Box sx={{ mt: 2 }}>
                    {question.subQuestions.map((subQuestion) => (
                      <Box key={subQuestion.id} sx={{ mb: 2, ml: 2 }}>
                        <Typography variant="body2" gutterBottom>
                          {subQuestion.id}: {subQuestion.text}
                        </Typography>
                        {subQuestion.type === 'yesno' && (
                          <RadioGroup
                            value={subQuestion.answer || ''}
                            onChange={(e) => handleSubQuestionChange(question.id, subQuestion.id, e.target.value)}
                            row
                          >
                            <FormControlLabel value="yes" control={<Radio />} label="Yes" />
                            <FormControlLabel value="no" control={<Radio />} label="No" />
                          </RadioGroup>
                        )}
                      </Box>
                    ))}
                  </Box>
                )}

                {question.type === 'paragraph' && (
                  <TextField
                    fullWidth
                    multiline
                    rows={3}
                    value={question.answer || ''}
                    onChange={(e) => handleAssessmentChange(question.id, e.target.value)}
                    placeholder="Enter your answer..."
                    sx={{ mt: 1 }}
                  />
                )}

                {question.skipLogic && question.answer === question.skipLogic.if && (
                  <Alert severity="info" sx={{ mt: 0.5 }}>
                    {question.skipLogic.showMessage}
                  </Alert>
                )}

                {/* Show existing gap plan if available */}
                {gapPlans.find(plan => plan.questionId === question.id) && (
                  <Box sx={{ mt: 0.5, p: 1, backgroundColor: 'grey.50', borderRadius: 1 }}>
                    <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                      Gap Plan:
                    </Typography>
                    <Typography variant="body2" sx={{ mb: 0.5 }}>
                      <strong>Action:</strong> {gapPlans.find(plan => plan.questionId === question.id)?.action}
                    </Typography>
                    <Typography variant="body2" sx={{ mb: 0.5 }}>
                      <strong>Owner:</strong> {gapPlans.find(plan => plan.questionId === question.id)?.owner}
                    </Typography>
                    <Typography variant="body2" sx={{ mb: 0.5 }}>
                      <strong>Status:</strong> {gapPlans.find(plan => plan.questionId === question.id)?.status}
                    </Typography>
                    <Box sx={{ display: 'flex', gap: 1, mt: 1 }}>
                      <Button
                        size="small"
                        variant="outlined"
                        onClick={() => handleGapPlanEdit(gapPlans.find(plan => plan.questionId === question.id)!)}
                      >
                        Edit
                      </Button>
                    </Box>
                  </Box>
                )}
              </Box>
            ))}



          </CardContent>
        </Card>
      </Box>

      {/* Add Score Dialog */}
      <Dialog open={openScoreDialog} onClose={() => setOpenScoreDialog(false)} maxWidth="sm" fullWidth>
        <DialogTitle>Add New Readiness Score</DialogTitle>
        <DialogContent>
          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12} sm={6}>
              <TextField
                fullWidth
                label="Date"
                type="date"
                value={scoreFormData.date}
                onChange={(e) => setScoreFormData({ ...scoreFormData, date: e.target.value })}
                InputLabelProps={{ shrink: true }}
              />
            </Grid>
            <Grid item xs={12} sm={6}>
              <TextField
                fullWidth
                label="Score (0-100)"
                type="number"
                value={scoreFormData.score}
                onChange={(e) => setScoreFormData({ ...scoreFormData, score: e.target.value })}
                inputProps={{ min: 0, max: 100, step: 0.001 }}
              />
            </Grid>
            <Grid item xs={12}>
              <Button
                variant="outlined"
                component="label"
                startIcon={<UploadIcon />}
                fullWidth
              >
                Upload PDF Score Report
                <input
                  type="file"
                  hidden
                  accept=".pdf"
                  onChange={(e) => setScoreFormData({ 
                    ...scoreFormData, 
                    pdfFile: e.target.files ? e.target.files[0] : null 
                  })}
                />
              </Button>
              {scoreFormData.pdfFile && (
                <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
                  Selected: {scoreFormData.pdfFile.name}
                </Typography>
              )}
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setOpenScoreDialog(false)}>Cancel</Button>
          <Button onClick={handleScoreSubmit} variant="contained">Add Score</Button>
        </DialogActions>
      </Dialog>

      {/* Gap Plan Dialog */}
      <Dialog open={openGapDialog} onClose={() => setOpenGapDialog(false)} maxWidth="md" fullWidth>
        <DialogTitle>
          Gap Plan for Question {selectedQuestion?.id}: {selectedQuestion?.text}
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="What is the action/plan to resolve?"
                multiline
                rows={3}
                value={gapFormData.action}
                onChange={(e) => setGapFormData({ ...gapFormData, action: e.target.value })}
              />
            </Grid>
            <Grid item xs={12} sm={6}>
              <TextField
                fullWidth
                label="Owner"
                value={gapFormData.owner}
                onChange={(e) => setGapFormData({ ...gapFormData, owner: e.target.value })}
              />
            </Grid>
            <Grid item xs={12} sm={6}>
              <FormControl fullWidth>
                <InputLabel>Status</InputLabel>
                <Select
                  value={gapFormData.status}
                  label="Status"
                  onChange={(e) => setGapFormData({ ...gapFormData, status: e.target.value as GapPlan['status'] })}
                >
                  <MenuItem value="">No Status</MenuItem>
                  <MenuItem value="In Progress">In Progress</MenuItem>
                  <MenuItem value="Needs Update">Needs Update</MenuItem>
                  <MenuItem value="Need to Develop">Need to Develop</MenuItem>
                  <MenuItem value="Cannot be done at this time">Cannot be done at this time</MenuItem>
                  <MenuItem value="Completed">Completed</MenuItem>
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12} sm={6}>
              <FormControl fullWidth>
                <InputLabel>Priority</InputLabel>
                <Select
                  value={gapFormData.priority}
                  label="Priority"
                  onChange={(e) => setGapFormData({ ...gapFormData, priority: e.target.value as GapPlan['priority'] })}
                >
                  <MenuItem value="">No Priority</MenuItem>
                  <MenuItem value="High Importance & High Urgency (Do Now)">High Importance & High Urgency (Do Now)</MenuItem>
                  <MenuItem value="High Importance & Low Urgency (Do Next)">High Importance & Low Urgency (Do Next)</MenuItem>
                  <MenuItem value="Low Importance & High Effort (Do Later)">Low Importance & Low Urgency (Do Later)</MenuItem>
                  <MenuItem value="Low Importance & Low Urgency (Do Last)">Low Importance & Low Urgency (Do Last)</MenuItem>
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12} sm={6}>
              <FormControl fullWidth>
                <InputLabel>Difficulty</InputLabel>
                <Select
                  value={gapFormData.difficulty}
                  label="Difficulty"
                  onChange={(e) => setGapFormData({ ...gapFormData, difficulty: e.target.value as GapPlan['difficulty'] })}
                >
                  <MenuItem value="">No Difficulty</MenuItem>
                  <MenuItem value="Low Impact & Low Effort (Filler Tasks)">Low Impact & Low Effort (Filler Tasks)</MenuItem>
                  <MenuItem value="Low Impact & High Effort (Hard Slogs)">Low Impact & High Effort (Hard Slogs)</MenuItem>
                  <MenuItem value="High Impact & Low Effort (Quick Wins)">High Impact & Low Effort (Quick Wins)</MenuItem>
                  <MenuItem value="High Impact & High Effort (Big Projects)">High Impact & High Effort (Big Projects)</MenuItem>
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12} sm={6}>
              <TextField
                fullWidth
                label="Due Date"
                type="date"
                value={gapFormData.dueDate}
                onChange={(e) => setGapFormData({ ...gapFormData, dueDate: e.target.value })}
                InputLabelProps={{ shrink: true }}
              />
            </Grid>
            <Grid item xs={12} sm={6}>
              <TextField
                fullWidth
                label="Rank"
                type="number"
                value={gapFormData.rank}
                onChange={(e) => setGapFormData({ ...gapFormData, rank: e.target.value === '' ? '' : parseInt(e.target.value) || '' })}
                placeholder="Leave blank for no rank"
                InputProps={{
                  inputProps: { min: 1 }
                }}
              />
            </Grid>
            {gapFormData.status === 'Completed' && (
              <Grid item xs={12}>
                <TextField
                  fullWidth
                  label="Completion Date"
                  type="date"
                  value={gapFormData.completionDate}
                  onChange={(e) => setGapFormData({ ...gapFormData, completionDate: e.target.value })}
                  InputLabelProps={{ shrink: true }}
                />
              </Grid>
            )}
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="Notes (Progress? Where did you get this information?)"
                multiline
                rows={3}
                value={gapFormData.notes}
                onChange={(e) => setGapFormData({ ...gapFormData, notes: e.target.value })}
              />
            </Grid>
            
            {/* File Attachments Section */}
            <Grid item xs={12}>
              <Box sx={{ border: '1px solid #ddd', borderRadius: 1, p: 2, bgcolor: '#fafafa' }}>
                <Typography variant="h6" gutterBottom>
                  File Attachments
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                  Upload PDFs or images related to this gap plan (e.g., policies, photos, documents)
                </Typography>
                
                {/* File Upload */}
                <Box sx={{ mb: 2 }}>
                  <input
                    accept=".pdf,.jpg,.jpeg,.png,.gif"
                    style={{ display: 'none' }}
                    id="gap-plan-file-upload"
                    type="file"
                    onChange={handleGapPlanFileUpload}
                    multiple
                  />
                  <label htmlFor="gap-plan-file-upload">
                    <Button variant="outlined" component="span" startIcon={<UploadIcon />}>
                      Upload Files
                    </Button>
                  </label>
                </Box>
                
                {/* Display Current Attachments */}
                {gapFormData.attachments.length > 0 && (
                  <Box>
                    <Typography variant="subtitle2" gutterBottom>
                      Current Attachments:
                    </Typography>
                    {gapFormData.attachments.map((attachment, index) => (
                      <Box key={attachment.id} sx={{ display: 'flex', alignItems: 'center', mb: 1, p: 1, bgcolor: 'white', borderRadius: 1 }}>
                        <Box sx={{ mr: 2 }}>
                          {attachment.fileType === 'pdf' ? <PictureAsPdfIcon color="error" /> : <ImageIcon color="primary" />}
                        </Box>
                        <Box sx={{ flex: 1 }}>
                          <Typography variant="body2">{attachment.fileName}</Typography>
                          <Typography variant="caption" color="text.secondary">
                            {(attachment.fileSize / 1024).toFixed(1)} KB • {attachment.uploadedAt.toLocaleDateString()}
                          </Typography>
                        </Box>
                        <IconButton
                          size="small"
                          onClick={() => handleRemoveAttachment(index)}
                          color="error"
                        >
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Box>
                    ))}
                  </Box>
                )}
              </Box>
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', width: '100%' }}>
            <Button 
              onClick={handleGapPlanDelete} 
              color="error" 
              variant="outlined"
              disabled={!gapPlans.find(plan => plan.questionId === selectedQuestion?.id)}
            >
              Delete Gap Plan
            </Button>
            <Box>
              <Button onClick={() => setOpenGapDialog(false)} sx={{ mr: 1 }}>Cancel</Button>
              <Button onClick={handleGapPlanSubmit} variant="contained">Save Gap Plan</Button>
            </Box>
          </Box>
        </DialogActions>
      </Dialog>
      <ScrollToTop />
    </Container>
  );
};

export default AssessmentPage;
